# ============================================================================
# Secure File Sharing — Environment Configuration
# Copy this file to .env and fill in real values
# NEVER commit the .env file — it contains secrets.
# ============================================================================

# Database Configuration — PostgreSQL
# Format: postgresql+psycopg2://user:password@host:port/dbname
DATABASE_URL=

# JWT Configuration
# IMPORTANT: Generate a strong random key for production
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Encryption Configuration
# Path to the Fernet encryption key file
ENCRYPTION_KEY_PATH=encryption.key

# File Upload Configuration
# Directory to store uploaded files
UPLOAD_DIR=./uploads

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173

# Application Configuration
# Name and version of the app, and debug flag
APP_NAME=Secure File Sharing
APP_VERSION=1.0.0
DEBUG=False

# Rate Limiting
# Login attempt limit
RATE_LIMIT_LOGIN=5/minute

# ============================================================================
# Blockchain Integration (OPTIONAL)
# ============================================================================
# Set to true to enable blockchain integrity anchoring
BLOCKCHAIN_ENABLED=false

# Web3 Provider URL (e.g., Infura Sepolia URL)
WEB3_PROVIDER_URL=

# Ethereum Private Key (64 hex characters)
# SECURITY: Never commit real private keys!
PRIVATE_KEY=

# Deployed Smart Contract Address (0x + 40 hex chars)
CONTRACT_ADDRESS=
